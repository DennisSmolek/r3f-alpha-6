{
  "compilerOptions": {
    "target": "es2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "esnext", "types": ["vite/client", "node"],
    "allowJs": true, "skipLibCheck": true, "moduleResolution": "bundler", "allowImportingTsExtensions": true,
    "isolatedModules": true, "moduleDetection": "force", "noEmit": true, "jsx": "react-jsx", "strict": true
  },
  "include": ["src"]
